{
  // What `pnpm build` compiles. Tests stay inside tsconfig.json's `include` so
  // eslint's projectService and `tsc --noEmit` both see them without an
  // allowDefaultProject entry (whose globs cannot contain `**`); they are kept
  // out of dist/ here instead.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./dist/.tsbuildinfo.build"
  },
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-support/**"]
}
