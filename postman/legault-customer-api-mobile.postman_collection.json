        {
          "name": "Addresses",
          "item": [
            {
              "name": "Create Address",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"label\": \"Home\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"street1\": \"123 Rue Sainte-Catherine\",\n  \"street2\": \"Apt 4\",\n  \"city\": \"Montreal\",\n  \"stateCode\": \"QC\",\n  \"postalCode\": \"H2X1Y4\",\n  \"countryCode\": \"CA\",\n  \"phone\": \"5145550123\",\n  \"phoneType\": \"mobile\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/{{apiVersion}}/member/addresses",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiVersion}}", "member", "addresses"]
                },
                "description": "Adds an address to the shopper's address book. 201 with the created address.\n\nRequired: `label`, `firstName`, `lastName`, `street1`, `city`, `stateCode`, `postalCode`, `phone`.\nOptional: `street2` (nullable), `countryCode` (2-letter ISO, defaults to `CA`), `phoneType` (`mobile` | `home`).\nUnknown keys are rejected.\n\nThe `id` in the response is the handle to use in every other address call — keep it, and store it client-side alongside the address. Postman saves it to `addressId`."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('201 Created', () => pm.response.to.have.status(201));",
                      "",
                      "const address = pm.response.json();",
                      "",
                      "pm.test('returns an address id', () => pm.expect(address.id).to.be.a('string'));",
                      "",
                      "if (address.id) {",
                      "  pm.environment.set('addressId', address.id);",
                      "}"
                    ]
                  }
                }
              ],
              "response": [
                {
                  "name": "201 Created",
