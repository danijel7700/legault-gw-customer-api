                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"5145550123\",\n  \"phoneType\": \"mobile\",\n  \"postalCode\": \"H2X1Y4\",\n  \"preferredStore\": \"store-042\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/{{apiVersion}}/member/profile",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiVersion}}", "member", "profile"]
                },
                "description": "Partial update. Send only the fields that changed; at least one is required and unknown keys are rejected.\n\n- `firstName` (≤40), `lastName` (≤80), `phone` (≤32), `postalCode` (≤16), `preferredStore` (≤64) — send `null` to clear a field, blank strings are rejected.\n- `phoneType` — `mobile` | `home`, only accepted alongside `phone`.\n\nEmail and birthday are not editable here."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
                  }
                }
