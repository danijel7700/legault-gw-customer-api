            {
              "name": "Update Profile",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "x-brand",
                    "value": "{{brand}}",
                    "description": "Required. rens | mondou"
                  },
                  {
                    "key": "x-customer-id",
                    "value": "{{customerId}}",
                    "description": "Required."
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"5145550123\",\n  \"phoneType\": \"mobile\",\n  \"postalCode\": \"H2X1Y4\",\n  \"preferredStore\": \"store-042\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
