    {
      "name": "Member",
      "description": "Customer profile and address book. Every request needs `x-brand`, `x-customer-id` and a Bearer access token.",
      "item": [
        {
          "name": "Profile",
          "item": [
            {
              "name": "Get Profile",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "x-brand",
                    "value": "{{brand}}",
                    "description": "Required. rens | mondou"
                  },
                  {
                    "key": "x-customer-id",
                    "value": "{{customerId}}",
                    "description": "Required. SFCC customer id, max 128 chars, [A-Za-z0-9_.~-]"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/{{apiVersion}}/member/profile",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiVersion}}", "member", "profile"]
                },
                "description": "Returns the stored profile, falling back to SFCC (and provisioning locally) on a first hit."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200 OK', () => pm.response.to.have.status(200));",
                      "",
                      "const body = pm.response.json();",
                      "",
                      "pm.test('addresses is an array', () => pm.expect(body.addresses).to.be.an('array'));",
                      "",
                      "const preferred = (body.addresses || []).find((address) => address.preferred);",
                      "",
                      "if (preferred && preferred.id) {",
                      "  pm.environment.set('addressId', preferred.id);",
                      "}"
                    ]
                  }
                }
              ],
              "response": [
                {
                  "name": "200 OK",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      { "key": "x-brand", "value": "{{brand}}" },
                      { "key": "x-customer-id", "value": "{{customerId}}" }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/{{apiVersion}}/member/profile",
                      "host": ["{{baseUrl}}"],
                      "path": ["{{apiVersion}}", "member", "profile"]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [{ "key": "Content-Type", "value": "application/json" }],
                  "cookie": [],
                  "body": "{\n  \"email\": \"jane.doe@example.com\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"5145550123\",\n  \"birthday\": \"1990-04-12\",\n  \"preferredLocale\": \"en-CA\",\n  \"postalCode\": \"H2X1Y4\",\n  \"preferredStore\": \"store-042\",\n  \"addresses\": [\n    {\n      \"id\": \"3f1a7c58-2f0d-4a2e-9d51-8b8a2c9f1e77\",\n      \"addressId\": \"home\",\n      \"address1\": \"123 Rue Sainte-Catherine\",\n      \"address2\": \"Apt 4\",\n      \"city\": \"Montreal\",\n      \"stateCode\": \"QC\",\n      \"postalCode\": \"H2X1Y4\",\n      \"countryCode\": \"CA\",\n      \"firstName\": \"Jane\",\n      \"lastName\": \"Doe\",\n      \"fullName\": \"Jane Doe\",\n      \"phone\": \"5145550123\",\n      \"preferred\": true\n    }\n  ]\n}"
                },
                {
                  "name": "400 Missing identity headers",
                  "originalRequest": {
                    "method": "GET",
                    "header": [{ "key": "x-brand", "value": "{{brand}}" }],
                    "url": {
                      "raw": "{{baseUrl}}/{{apiVersion}}/member/profile",
                      "host": ["{{baseUrl}}"],
                      "path": ["{{apiVersion}}", "member", "profile"]
                    }
                  },
                  "status": "Bad Request",
