                "url": {
                  "raw": "{{baseUrl}}/{{apiVersion}}/member/addresses",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiVersion}}", "member", "addresses"]
                },
                "description": "Creates an address at SFCC and mirrors it locally. Returns 201 with the stored address.\n\nRequired: `label`, `firstName`, `lastName`, `street1`, `city`, `stateCode`, `postalCode`, `phone`.\nOptional: `street2` (nullable), `countryCode` (2-letter ISO, defaults to `CA`), `phoneType` (`mobile` | `home`).\nUnknown keys are rejected.\n\nThe returned `id` is saved to the `addressId` environment variable for the requests below."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('201 Created', () => pm.response.to.have.status(201));",
                      "",
                      "const address = pm.response.json();",
                      "",
                      "pm.test('returns a local id', () => pm.expect(address.id).to.be.a('string'));",
                      "",
                      "if (address.id) {",
                      "  pm.environment.set('addressId', address.id);",
                      "}"
                    ]
                  }
                }
              ],
