                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"label\": \"Home\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"street1\": \"123 Rue Sainte-Catherine\",\n  \"street2\": \"Apt 4\",\n  \"city\": \"Montreal\",\n  \"stateCode\": \"QC\",\n  \"postalCode\": \"H2X1Y4\",\n  \"countryCode\": \"CA\",\n  \"phone\": \"5145550123\",\n  \"phoneType\": \"mobile\"\n}",
