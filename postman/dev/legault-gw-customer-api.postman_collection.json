        {
          "name": "Brand Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "x-brand",
                "value": "{{brand}}",
                "description": "Required. rens | mondou"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "health"]
            },
            "description": "Versioned, brand-scoped health. Echoes the resolved public SFCC configuration for the brand.\n\n400 `MISSING_BRAND` when `x-brand` is absent, 400 `UNKNOWN_BRAND` for an unsupported brand, 400 `UNSUPPORTED_API_VERSION` for a version other than `v1`."
          },
          "event": [
